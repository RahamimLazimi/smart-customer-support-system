root = true

[*.cs]

#### Formatting ####

# Braces style (JS-like)
csharp_new_line_before_open_brace = none

# Indentation
indent_style = space
indent_size = 4

# Using directives
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = true

# New lines
csharp_new_line_between_members = true

#### Naming ####

# General naming styles
dotnet_naming_rule.types_should_be_pascal_case.severity = suggestion
dotnet_naming_rule.methods_should_be_pascal_case.severity = suggestion
dotnet_naming_rule.parameters_should_be_camel_case.severity = suggestion
dotnet_naming_rule.fields_should_be_private_and_camel_case.severity = suggestion

#### Style ####

csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion

# Expression-bodied members
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = when_on_single_line:suggestion

# Null checks
csharp_style_throw_expression = true:suggestion

#### File headers (optional) ####
file_header_template = unset